{
  "name": "@sinapsis/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sinapsis": "./bin/sinapsis.mjs"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinapsis/contract": "workspace:*",
    "@sinapsis/markdown": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
