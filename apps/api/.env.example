# Puerto del API
PORT=3000
# Archivo SQLite (libsql). En deploy: libsql://<db>.turso.io + TURSO_AUTH_TOKEN
DATABASE_URL=file:./data/sinapsis.db
# Secreto para firmar la cookie de sesión (>= 32 chars aleatorios)
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Google OAuth 2.0 Client ID (tipo "Web application", origen http://localhost:5173 y http://localhost:3000)
GOOGLE_CLIENT_ID=
# Token compartido con el CLI de sync
SYNC_TOKEN=cambiar-por-otro-secreto
# Solo desarrollo: habilita POST /api/auth/dev. El API se niega a arrancar si está activo con NODE_ENV=production.
AUTH_DEV_BYPASS=1
# Fuerza la cookie de sesión con Secure fuera de producción (p. ej. detrás de un proxy https)
COOKIE_SECURE=0
# Carpeta con el build de la SPA para servirla en producción (opcional)
WEB_DIST=../web/dist
# Orígenes adicionales admitidos por el guard CSRF (coma). En producción, el dominio de la SPA si difiere del API.
ALLOWED_ORIGINS=
